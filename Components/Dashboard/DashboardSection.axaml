<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_ModParts.Components.Dashboard.DashboardSection"
             x:Name="Root">
    <StackPanel Spacing="{DynamicResource Gap.Compact}">
        <TextBlock Classes="section-title"
                   Text="{Binding Title, ElementName=Root}" />
        <ContentPresenter Content="{Binding Body, ElementName=Root}" />
    </StackPanel>
</UserControl>
