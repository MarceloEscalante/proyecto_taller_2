<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Sistema_ModParts.Components.Dashboard"
             xmlns:vm="using:Sistema_ModParts.ViewModels"
             x:Class="Sistema_ModParts.Views.Dashboards.WarehouseDashboardView"
             x:DataType="vm:WarehouseDashboardViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="{DynamicResource Gap.Section}">
        <StackPanel Grid.Row="0"
                    Spacing="{DynamicResource Gap.Tight}">
            <TextBlock Classes="page-title"
                       Text="{Binding Title}" />
            <TextBlock Classes="secondary page-description"
                       Text="{Binding Description}" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource Gap.Section}">
            <dashboard:KpiCard Grid.Column="0"
                               Title="Stock bajo"
                               ValuePlaceholder="Pending"
                               StatusText="Indicador reservado" />
            <dashboard:KpiCard Grid.Column="1"
                               Title="Control de inventario"
                               ValuePlaceholder="Pending"
                               StatusText="Indicador reservado" />
        </Grid>

        <dashboard:DashboardSection Grid.Row="2"
                                     Title="Actividad de depósito">
            <dashboard:DashboardSection.Body>
                <dashboard:EmptyState Title="Sin movimientos disponibles"
                                      Description="Los movimientos de inventario se incorporarán en una fase posterior." />
            </dashboard:DashboardSection.Body>
        </dashboard:DashboardSection>
    </Grid>
</UserControl>
