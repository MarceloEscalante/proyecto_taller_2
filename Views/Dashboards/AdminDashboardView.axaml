<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Sistema_ModParts.Components.Dashboard"
             xmlns:vm="using:Sistema_ModParts.ViewModels"
             x:Class="Sistema_ModParts.Views.Dashboards.AdminDashboardView"
             x:DataType="vm:AdminDashboardViewModel">
    <ScrollViewer>
        <Grid>
            <Grid IsVisible="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" />
                <TextBlock Text="Cargando indicadores..." HorizontalAlignment="Center" Margin="0,60,0,0" />
            </Grid>

            <StackPanel Spacing="{DynamicResource Gap.Section}" IsVisible="{Binding !IsLoading}">
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <dashboard:KpiCard Title="{Binding Title}"
                                               ValuePlaceholder="{Binding Value}"
                                               StatusText="{Binding Trend}"
                                               Margin="0,0,16,16" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <dashboard:DashboardSection Title="Actividad administrativa">
                    <dashboard:DashboardSection.Body>
                        <dashboard:EmptyState Title="Sin actividad disponible"
                                              Description="La actividad administrativa se incorporará en una fase posterior." />
                    </dashboard:DashboardSection.Body>
                </dashboard:DashboardSection>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
