<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Sistema_ModParts.Components.Dashboard"
             xmlns:vm="using:Sistema_ModParts.ViewModels"
             x:Class="Sistema_ModParts.Views.Dashboards.SellerDashboardView"
             x:DataType="vm:SellerDashboardViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="{DynamicResource Gap.Section}">
        <StackPanel Grid.Row="0"
                    Spacing="{DynamicResource Gap.Tight}">
            <TextBlock Classes="page-title"
                       Text="{Binding Title}" />
            <TextBlock Classes="secondary page-description"
                       Text="{Binding Description}" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*"
              MaxWidth="420">
            <dashboard:KpiCard Title="Ventas propias del día"
                               ValuePlaceholder="Pending"
                               StatusText="Indicador reservado" />
        </Grid>

        <dashboard:DashboardSection Grid.Row="2"
                                     Title="Actividad comercial">
            <dashboard:DashboardSection.Body>
                <dashboard:EmptyState Title="Sin actividad disponible"
                                      Description="La actividad comercial se incorporará en una fase posterior." />
            </dashboard:DashboardSection.Body>
        </dashboard:DashboardSection>
    </Grid>
</UserControl>
