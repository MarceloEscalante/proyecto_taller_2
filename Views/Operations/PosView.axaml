<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sistema_ModParts.ViewModels.Operations"
             x:Class="Sistema_ModParts.Views.Operations.PosView"
             x:DataType="vm:PosViewModel">

    <Grid ColumnDefinitions="*,350" RowDefinitions="*">
        
        <!-- Left: Carrito y Búsqueda -->
        <Border Grid.Column="0" Classes="surface" Margin="0,0,16,0">
            <Grid RowDefinitions="Auto,*">
                
                <!-- Buscador Rápido -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBox Grid.Column="0" Text="{Binding QuickSearchText}" Watermark="Escanea o escribe código para buscar (Enter)..." Classes="large">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding QuickSearchCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="secondary" Content="Buscar Manual (F2)" Command="{Binding OpenSearchCommand}" HotKey="F2" Margin="8,0,0,0" VerticalAlignment="Stretch" />
                </Grid>
                
                <!-- Grilla de Productos -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderSubtle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding IdProducto}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Nombre del Repuesto" Binding="{Binding Nombre}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitario, StringFormat=c}" IsReadOnly="True" />
                        
                        <DataGridTemplateColumn Header="Cant.">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <NumericUpDown Value="{Binding Cantidad}" Minimum="1" FormatString="0" Margin="4" ShowButtonSpinner="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=c}" IsReadOnly="True" FontWeight="SemiBold" />
                        
                        <DataGridTemplateColumn Header="X">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="action" Content="Quitar" Command="{Binding $parent[DataGrid].((vm:PosViewModel)DataContext).RemoveItemCommand}" CommandParameter="{Binding}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
            </Grid>
        </Border>

        <!-- Right: Resumen y Pago -->
        <Border Grid.Column="1" Classes="surface">
            <StackPanel Spacing="16">
                
                <TextBlock Text="Resumen de Venta" Classes="h2" Margin="0,0,0,16" />
                
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Artículos en carrito:" FontSize="16" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalArticulos}" FontSize="16" FontWeight="Bold" />
                </Grid>
                
                <Separator Margin="0,8" Background="{DynamicResource Brush.BorderSubtle}" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <TextBlock Text="TOTAL:" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=c}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.Action}" />
                </Grid>
                
                <Button Classes="primary" Content="Finalizar Venta (F5)" Command="{Binding ProcessSaleCommand}" HotKey="F5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,32,0,0" Padding="16" FontSize="18" />
                
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
