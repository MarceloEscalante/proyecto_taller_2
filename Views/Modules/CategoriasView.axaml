<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sistema_ModParts.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="Sistema_ModParts.Views.CategoriasView"
             x:DataType="vm:CategoriasViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox, ComboBox, NumericUpDown">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="TextElement.Foreground" Value="#CCCCCC"/>
        </Style>
        <Style Selector="DataGrid TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="6*, 4*" Margin="30" ColumnSpacing="30">
        
        <!-- TARJETA IZQUIERDA: Lista de Categorías -->
        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Padding="25"
                BoxShadow="0 8 20 0 #30000000">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Catálogo de Categorías" FontSize="26" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                    <TextBlock Text="Administra las categorías de productos. Selecciona una categoría para editarla." 
                               FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,15"/>
                               
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Buscar categoría por nombre..." 
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                
                <Grid>
                    <!-- Indicador de Carga -->
                    <StackPanel IsVisible="{Binding IsLoading}" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Spacing="15">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                        <TextBlock Text="Cargando categorías..." Foreground="#CCCCCC" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Lista de Categorías -->
                    <DataGrid ItemsSource="{Binding Categorias}" 
                              SelectedItem="{Binding CategoriaSeleccionada}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="None"
                              BorderThickness="1" BorderBrush="#333333"
                              IsVisible="{Binding !IsLoading}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdCategoria}" Width="Auto"/>
                            <DataGridTextColumn Header="Nombre de la Categoría" Binding="{Binding NombreCategoria}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- TARJETA DERECHA: Formulario -->
        <Border Grid.Column="1" Background="#252526" Padding="30" CornerRadius="12"
                BoxShadow="0 8 20 0 #40000000" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" FontSize="22" FontWeight="Bold" 
                           Foreground="#CCCCCC" Margin="0,0,0,25"/>
                
                <TextBlock Text="Nombre" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,8" FontWeight="Medium"/>
                <TextBox Text="{Binding NombreCategoria}" PlaceholderText="Ej: Herramientas"/>

                <TextBlock Text="{Binding Mensaje}" Foreground="#FF6B6B" FontSize="14" 
                           TextWrapping="Wrap" MinHeight="22" Margin="0,0,0,20" FontWeight="SemiBold"/>

                <!-- Botones de Acción -->
                <StackPanel Orientation="Vertical" Spacing="15">
                    <Button Content="Guardar Categoría" Command="{Binding GuardarCommand}" 
                            Background="#0078D4" Foreground="#CCCCCC" 
                            HorizontalAlignment="Stretch" FontSize="16" Height="45"/>
                    
                    <Grid ColumnDefinitions="*,*" Margin="0">
                        <Button Grid.Column="0" Content="Eliminar" Command="{Binding EliminarCommand}" 
                                IsVisible="{Binding EsEdicion}" 
                                Background="#D13438" Foreground="#CCCCCC" 
                                HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                        
                        <Button Grid.Column="1" Content="Limpiar" Command="{Binding LimpiarFormularioCommand}" 
                                Background="Transparent" BorderBrush="#555555" BorderThickness="1" Foreground="#CCCCCC"
                                HorizontalAlignment="Stretch" Margin="5,0,0,0"
                                IsVisible="{Binding EsEdicion}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
