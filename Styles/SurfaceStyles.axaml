<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Standard}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Section}" />
    </Style>

    <Style Selector="Border.muted-surface">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Standard}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Section}" />
        <Setter Property="MinHeight" Value="120" />
    </Style>

    <Style Selector="Border.container">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Page}" />
    </Style>

    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Standard}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Dialog}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Section}" />
        <Setter Property="MinWidth" Value="{DynamicResource Dimension.DialogMinWidth}" />
    </Style>

    <Style Selector="Border.empty-state">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.Page}" />
        <Setter Property="MinHeight" Value="160" />
    </Style>

    <Style Selector="Border.empty-state-mark">
        <Setter Property="Padding" Value="{DynamicResource Spacing.Compact}" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
</Styles>
