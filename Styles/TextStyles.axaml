<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.PageTitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource Typography.Weight.Semibold}" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Section}" />
        <Setter Property="FontWeight" Value="{DynamicResource Typography.Weight.Semibold}" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Label}" />
        <Setter Property="FontWeight" Value="{DynamicResource Typography.Weight.Medium}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <Style Selector="TextBlock.kpi-placeholder">
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.PageTitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource Typography.Weight.Semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
</Styles>
