<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="Typography.Family.Primary">Inter</FontFamily>
    <FontWeight x:Key="Typography.Weight.Regular">Normal</FontWeight>
    <FontWeight x:Key="Typography.Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="Typography.Weight.Semibold">SemiBold</FontWeight>
    <FontWeight x:Key="Typography.Weight.Bold">Bold</FontWeight>

    <x:Double x:Key="Typography.Size.Caption">11</x:Double>
    <x:Double x:Key="Typography.Size.Label">12</x:Double>
    <x:Double x:Key="Typography.Size.Body">14</x:Double>
    <x:Double x:Key="Typography.Size.Subtitle">16</x:Double>
    <x:Double x:Key="Typography.Size.Section">18</x:Double>
    <x:Double x:Key="Typography.Size.PageTitle">28</x:Double>
    <x:Double x:Key="Typography.Size.Brand">18</x:Double>
</ResourceDictionary>
