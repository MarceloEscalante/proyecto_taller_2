<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#F5F7FA</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceMuted">#EEF1F5</Color>
    <Color x:Key="Color.Border">#D8DEE8</Color>
    <Color x:Key="Color.TextPrimary">#1F2937</Color>
    <Color x:Key="Color.TextSecondary">#5B6678</Color>
    <Color x:Key="Color.Action">#245B8F</Color>
    <Color x:Key="Color.ActionHover">#1D4B77</Color>
    <Color x:Key="Color.Success">#2F7D4A</Color>
    <Color x:Key="Color.Warning">#A66A00</Color>
    <Color x:Key="Color.Error">#B54242</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{DynamicResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Action" Color="{DynamicResource Color.Action}" />
    <SolidColorBrush x:Key="Brush.ActionHover" Color="{DynamicResource Color.ActionHover}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}" />

    <Thickness x:Key="Spacing.Page">32</Thickness>
    <Thickness x:Key="Spacing.Section">24</Thickness>
    <Thickness x:Key="Spacing.Control">12</Thickness>
    <Thickness x:Key="Spacing.Compact">8</Thickness>
    <Thickness x:Key="Spacing.Tight">4</Thickness>

    <x:Double x:Key="Gap.Section">24</x:Double>
    <x:Double x:Key="Gap.Control">12</x:Double>
    <x:Double x:Key="Gap.Compact">8</x:Double>
    <x:Double x:Key="Gap.Tight">4</x:Double>

    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Surface">6</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>

    <x:Double x:Key="Dimension.ControlHeight">40</x:Double>
    <x:Double x:Key="Dimension.ButtonMinWidth">112</x:Double>
    <Thickness x:Key="Dimension.BorderThickness">1</Thickness>
</ResourceDictionary>
