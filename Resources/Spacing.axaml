<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Numeric gaps for StackPanel and Grid spacing properties. -->
    <x:Double x:Key="Gap.Page">32</x:Double>
    <x:Double x:Key="Gap.Section">24</x:Double>
    <x:Double x:Key="Gap.Control">12</x:Double>
    <x:Double x:Key="Gap.Compact">8</x:Double>
    <x:Double x:Key="Gap.Tight">4</x:Double>

    <!-- Thickness values for Padding, Margin and related properties. -->
    <Thickness x:Key="Spacing.Page">32</Thickness>
    <Thickness x:Key="Spacing.Section">24</Thickness>
    <Thickness x:Key="Spacing.Control">12</Thickness>
    <Thickness x:Key="Spacing.Compact">8</Thickness>
    <Thickness x:Key="Spacing.Tight">4</Thickness>
</ResourceDictionary>
